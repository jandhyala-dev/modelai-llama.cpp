#!/bin/bash
# modelai — simple model runner for modelai-llama.cpp
# Usage: ./modelai run <model> [--ctx N]

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CLI="$SCRIPT_DIR/build/bin/llama-cli"
MODEL_DIR="${MODELAI_MODELS_DIR:-/Users/ajayjandhyala/dev/whippet/models}"

# Default settings
CTX=4096
NGL=99
TEMP=0.6

# Model aliases
declare -A MODELS
MODELS[qwen3-30b]="Qwen3-30B-A3B-Instruct-Q4_K_M.gguf"
MODELS[qwen3-14b]="Qwen3-14B-Instruct-Q4_K_M.gguf"
MODELS[qwen3-8b]="Qwen3-8B-Instruct-Q4_K_M.gguf"
MODELS[qwen2.5-coder]="Qwen2.5-Coder-14B-Instruct-Q4_K_M.gguf"
MODELS[deepseek-r1]="DeepSeek-R1-Distill-Qwen-14B-Q4_K_M.gguf"

usage() {
    echo "Usage: modelai run <model> [--ctx N]"
    echo ""
    echo "Models:"
    for key in "${!MODELS[@]}"; do
        file="${MODELS[$key]}"
        if [ -f "$MODEL_DIR/$file" ]; then
            echo "  $key  ✓"
        else
            echo "  $key  (not downloaded)"
        fi
    done
    echo ""
    echo "Examples:"
    echo "  modelai run qwen3-30b"
    echo "  modelai run qwen3-30b --ctx 8192"
}

if [ "$1" != "run" ] || [ -z "$2" ]; then
    usage
    exit 1
fi

MODEL_KEY="$2"
shift 2

# Parse optional flags
while [ $# -gt 0 ]; do
    case "$1" in
        --ctx) CTX="$2"; shift 2 ;;
        *) echo "Unknown flag: $1"; exit 1 ;;
    esac
done

MODEL_FILE="${MODELS[$MODEL_KEY]}"
if [ -z "$MODEL_FILE" ]; then
    echo "Unknown model: $MODEL_KEY"
    usage
    exit 1
fi

MODEL_PATH="$MODEL_DIR/$MODEL_FILE"
if [ ! -f "$MODEL_PATH" ]; then
    echo "Model not found: $MODEL_PATH"
    echo "Download it first or symlink it into $MODEL_DIR/"
    exit 1
fi

exec "$CLI" \
    -m "$MODEL_PATH" \
    -c "$CTX" \
    -ngl "$NGL" \
    --temp "$TEMP" \
    -cnv
